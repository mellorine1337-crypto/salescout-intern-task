{
  "name": "salescout-intern-task",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "dev": "concurrently -k npm:dev:server npm:dev:client",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "cors": "^2.8.5", "express": "^4.21.2", "react": "^18.3.1", "react-dom": "^18.3.1" },
  "devDependencies": {
    "@types/cors": "^2.8.17", "@types/express": "^4.17.21",
    "@types/node": "^22.13.0", "@types/react": "^18.3.18", "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2", "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2", "supertest": "^7.0.0", "tsx": "^4.19.2",
    "typescript": "^5.6.0", "vite": "^6.1.0", "vitest": "^3.0.5"
  }
}
